{
  "name": "workspace-history-porter",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:extension": "node tests/extension-smoke.mjs",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && vite build --config vite.site.config.ts && node scripts/package.mjs && node scripts/verify-packaged-artifacts.mjs",
    "build": "npm run build:site",
    "test:package": "npm run build:site",
    "sidecar": "node sidecar/porter-sidecar.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "overrides": {
    "vite": "$vite"
  }
}
