{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["entrypoints", "lib", "site", "tests", "wxt.config.ts", "vite.site.config.ts"]
}
